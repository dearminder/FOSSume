<?xml version="1.0" encoding="utf-8"?>
<!-- Generated from logo.svg: the logo fills the middle 70dp of the 108dp layers, so a circle mask
     keeps all of its artwork, and the margin repeats the logo's edge. The monochrome (themed) icon
     is the logo's yellow and orange shapes. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/ic_launcher_background"/>
  <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
  <monochrome android:drawable="@mipmap/ic_launcher_monochrome"/>
</adaptive-icon>
